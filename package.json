{
    "name": "the-grief-app-tests",
    "version": "1.0.0",
    "author": "Marlon Carbonero",
    "license": "ISC",
    "description": "Automation tests for TGA App using WebdriverIO and Appium",
    "type": "module",
    "scripts": {
        "android.app": "wdio run config/wdio.android.app.conf.ts",
        "android.app.smoke": "wdio run config/wdio.android.app.conf.ts --cucumberOpts.tags=@smoke",
        "android.app.memoryBook": "npm run test:android -- --spec features/memory_book.feature && npm run report:generate && npm run report:open",
        "android.app.goodMoments": "npm run test:android -- --spec features/good_moments.feature && npm run report:generate && npm run report:open",
        "android.app.griefWave": "npm run test:android -- --spec features/grief_wave.feature && npm run report:generate && npm run report:open",
        "android.browser": "wdio run config/wdio.android.browser.conf.ts",
        "browser": "wdio run config/wdio.browser.conf.ts",
        "ios.app": "wdio run config/wdio.ios.app.conf.ts",
        "ios.browser": "wdio run config/wdio.ios.browser.conf.ts",
        "lint": "eslint config tests",
        "appium:inspector": "bash scripts/start-appium-inspector.sh",
        "appium:inspector:win": "scripts\\start-appium-inspector.bat",
     "test:android": "wdio run config/wdio.android.app.conf.ts",
  "report:generate": "allure generate allure-results -o ./Reports --clean",
  "report:open": "allure open ./Reports",
  "all-in-one": "npm run test:android && npm run report:generate && npm run report:open"
},
    "devDependencies": {
        "@cucumber/cucumber": "^12.4.0",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "@wdio/allure-reporter": "^9.24.0",
        "@wdio/appium-service": "^9.20.0",
        "@wdio/cli": "^9.20.0",
        "@wdio/cucumber-framework": "^9.21.0",
        "@wdio/globals": "^9.17.0",
        "@wdio/local-runner": "^9.20.0",
        "@wdio/spec-reporter": "^9.20.0",
        "allure-commandline": "^2.36.0",
        "appium": "^3.0.2",
        "appium-uiautomator2-driver": "^5.0.4",
        "appium-xcuitest-driver": "10.1.4",
        "dotenv": "^17.2.3",
        "eslint-plugin-wdio": "^9.16.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
